# Backend only. Never put credentials in VITE_ variables.
# Recommended: generate a TOTP token in Groww Cloud API Keys (one-time setup).
# Use the TOTP token and base32 secret, not a current six-digit OTP.
GROWW_TOTP_TOKEN=
GROWW_TOTP_SECRET=
# Legacy daily-approval flow:
GROWW_API_KEY=
GROWW_API_SECRET=
# Alternatively supply an approved access token:
GROWW_ACCESS_TOKEN=
