{
  "openapi": "3.1.0",
  "info": {
    "title": "Edge Relative Groww workspace",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/instruments": {
      "get": {
        "summary": "Instruments",
        "operationId": "instruments_api_v1_instruments_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Instrument"
                  },
                  "type": "array",
                  "title": "Response Instruments Api V1 Instruments Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/instruments/sync": {
      "post": {
        "summary": "Sync",
        "operationId": "sync_api_v1_instruments_sync_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Instrument"
                  },
                  "type": "array",
                  "title": "Response Sync Api V1 Instruments Sync Post"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scan": {
      "post": {
        "summary": "Scan",
        "operationId": "scan_api_v1_scan_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanSnapshot"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/snapshot": {
      "get": {
        "summary": "Snapshot",
        "operationId": "snapshot_api_v1_snapshot_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanSnapshot"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/charts/{symbol}": {
      "get": {
        "summary": "Chart",
        "operationId": "chart_api_v1_charts__symbol__get",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Symbol"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChartResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/exports/run.zip": {
      "get": {
        "summary": "Export Run",
        "operationId": "export_run_api_v1_exports_run_zip_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/zip": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "No loaded run"
          },
          "409": {
            "description": "Run replaced"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/exports/{symbol}.csv": {
      "get": {
        "summary": "Export",
        "operationId": "export_api_v1_exports__symbol__csv_get",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Symbol"
            }
          },
          {
            "name": "run_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "No loaded chart"
          },
          "409": {
            "description": "Run replaced"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChartPoint": {
        "properties": {
          "time": {
            "type": "integer",
            "title": "Time"
          },
          "open": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Open"
          },
          "high": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "High"
          },
          "low": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Low"
          },
          "close": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Close"
          },
          "volume": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Volume"
          },
          "features": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Features"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "time",
          "open",
          "high",
          "low",
          "close",
          "volume",
          "features"
        ],
        "title": "ChartPoint"
      },
      "ChartResponse": {
        "properties": {
          "run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id"
          },
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "timezone": {
            "type": "string",
            "const": "Asia/Kolkata",
            "title": "Timezone",
            "default": "Asia/Kolkata"
          },
          "price_unit": {
            "type": "string",
            "const": "INR",
            "title": "Price Unit",
            "default": "INR"
          },
          "volume_unit": {
            "type": "string",
            "const": "shares",
            "title": "Volume Unit",
            "default": "shares"
          },
          "price_benchmark": {
            "type": "string",
            "title": "Price Benchmark"
          },
          "volume_benchmark": {
            "type": "string",
            "title": "Volume Benchmark"
          },
          "sector_benchmark": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sector Benchmark"
          },
          "parameters": {
            "additionalProperties": true,
            "type": "object",
            "title": "Parameters"
          },
          "regime_labels": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Regime Labels"
          },
          "quality": {
            "$ref": "#/components/schemas/ScannerRow"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/ChartPoint"
            },
            "type": "array",
            "title": "Points"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "symbol",
          "price_benchmark",
          "volume_benchmark",
          "sector_benchmark",
          "parameters",
          "regime_labels",
          "quality",
          "points"
        ],
        "title": "ChartResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IndicatorSettings": {
        "properties": {
          "length": {
            "type": "integer",
            "maximum": 200.0,
            "minimum": 2.0,
            "title": "Length",
            "default": 12
          },
          "smoothVol": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Smoothvol",
            "default": 3
          },
          "atrPeriod": {
            "type": "integer",
            "maximum": 200.0,
            "minimum": 2.0,
            "title": "Atrperiod",
            "default": 14
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "IndicatorSettings"
      },
      "Instrument": {
        "properties": {
          "symbol": {
            "type": "string",
            "pattern": "^[A-Z0-9 &.\\-]{1,40}$",
            "title": "Symbol"
          },
          "kind": {
            "type": "string",
            "enum": [
              "stock",
              "index",
              "etf"
            ],
            "title": "Kind"
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": true
          },
          "sector": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sector"
          },
          "groww_symbol": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Groww Symbol"
          },
          "exchange_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exchange Token"
          },
          "exchange": {
            "type": "string",
            "const": "NSE",
            "title": "Exchange",
            "default": "NSE"
          },
          "segment": {
            "type": "string",
            "const": "CASH",
            "title": "Segment",
            "default": "CASH"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "symbol",
          "kind"
        ],
        "title": "Instrument"
      },
      "ScanRequest": {
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "title": "End"
          },
          "refresh": {
            "type": "boolean",
            "title": "Refresh",
            "default": false
          },
          "live": {
            "type": "boolean",
            "title": "Live",
            "default": false
          },
          "market_filter": {
            "type": "boolean",
            "title": "Market Filter",
            "default": false
          },
          "sector_filter": {
            "type": "boolean",
            "title": "Sector Filter",
            "default": false
          },
          "volume_filter": {
            "type": "boolean",
            "title": "Volume Filter",
            "default": false
          },
          "min_volume_momentum": {
            "type": "number",
            "title": "Min Volume Momentum",
            "default": 0
          },
          "price_benchmark": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price Benchmark"
          },
          "volume_benchmark": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Volume Benchmark"
          },
          "parameters": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IndicatorSettings"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "start",
          "end"
        ],
        "title": "ScanRequest"
      },
      "ScanSnapshot": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Generated At"
          },
          "as_of": {
            "type": "string",
            "format": "date-time",
            "title": "As Of"
          },
          "timezone": {
            "type": "string",
            "const": "Asia/Kolkata",
            "title": "Timezone",
            "default": "Asia/Kolkata"
          },
          "price_benchmark": {
            "type": "string",
            "title": "Price Benchmark"
          },
          "volume_benchmark": {
            "type": "string",
            "title": "Volume Benchmark"
          },
          "rows": {
            "items": {
              "$ref": "#/components/schemas/ScannerRow"
            },
            "type": "array",
            "title": "Rows"
          },
          "diagnostics": {
            "additionalProperties": true,
            "type": "object",
            "title": "Diagnostics"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "generated_at",
          "as_of",
          "price_benchmark",
          "volume_benchmark",
          "rows",
          "diagnostics"
        ],
        "title": "ScanSnapshot"
      },
      "ScannerRow": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "candle_time": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Candle Time"
          },
          "close": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Close"
          },
          "rrs": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rrs"
          },
          "previous_rrs": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous Rrs"
          },
          "rrv": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rrv"
          },
          "relative_volatility": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Relative Volatility"
          },
          "sector_rrs": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sector Rrs"
          },
          "sector_state": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sector State"
          },
          "market_regime": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Market Regime"
          },
          "direction": {
            "type": "string",
            "enum": [
              "bullish",
              "bearish",
              "mixed",
              "unavailable"
            ],
            "title": "Direction",
            "default": "unavailable"
          },
          "quality": {
            "type": "string",
            "enum": [
              "ready",
              "historical",
              "stale",
              "missing",
              "warmup",
              "error"
            ],
            "title": "Quality",
            "default": "missing"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reasons"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "symbol"
        ],
        "title": "ScannerRow"
      },
      "Status": {
        "properties": {
          "provider": {
            "type": "string",
            "const": "groww",
            "title": "Provider",
            "default": "groww"
          },
          "configured": {
            "type": "boolean",
            "title": "Configured"
          },
          "snapshot_available": {
            "type": "boolean",
            "title": "Snapshot Available",
            "default": false
          },
          "feed": {
            "type": "string",
            "enum": [
              "disabled",
              "connecting",
              "connected",
              "stale",
              "disconnected"
            ],
            "title": "Feed",
            "default": "disabled"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "configured",
          "message"
        ],
        "title": "Status"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
